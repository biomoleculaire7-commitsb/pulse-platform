# ── RES Platform Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values before running

# Database
DB_PASSWORD=change-me-strong-password

# JWT Secret (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-run-openssl-rand-hex-32

# Master API Key (used for initial dashboard login + creating new API keys)
MASTER_API_KEY=change-me-master-key-min-32-chars

# Frontend API key (used by the browser)
VITE_API_KEY=change-me-api-key
VITE_API_URL=http://localhost:8000/api
